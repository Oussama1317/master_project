   "source": [
    "# Master Project: AI Insurance Adjuster\n",
    "## YOLOv8 Training on D-Fire Dataset (Fire & Smoke Detection)\n",
    "\n",
    "Run this notebook in Google Colab with GPU runtime: `Runtime` -> `Change runtime type` -> `T4 GPU`"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from google.colab import drive\n",
    "drive.mount('/content/drive')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Upload master_project.zip to Google Drive, then uncomment:\n",
    "# !unzip -q /content/drive/MyDrive/master_project.zip -d /content/master_project\n",
    "\n",
    "# Clone from GitHub:\n",
    "!git clone https://github.com/Oussama1317/master_project.git /content/master_project\n",
    "\n",
    "import os\n",
    "os.makedirs('/content/master_project', exist_ok=True)\n",
    "%cd /content/master_project"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!pip install -q ultralytics kagglehub"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import kagglehub\n",
    "import shutil\n",
    "from pathlib import Path\n",
    "\n",
    "DATA_DIR = Path(\"data/raw/dfire\")\n",
    "if not DATA_DIR.exists():\n",
    "    print(\"Downloading D-Fire dataset...\")\n",
    "    path = Path(kagglehub.dataset_download(\"sayedgamal99/smoke-fire-detection-yolo\"))\n",
    "    DATA_DIR.mkdir(parents=True, exist_ok=True)\n",
    "    for item in path.iterdir():\n",
    "        dest = DATA_DIR / item.name\n",
    "        if dest.exists():\n",
    "            if item.is_dir():\n",
    "                shutil.rmtree(str(dest))\n",
    "            else:\n",
    "                dest.unlink()\n",
    "        if item.is_dir():\n",
    "            shutil.copytree(str(item), str(dest))\n",
    "        else:\n",
    "            shutil.copy2(str(item), str(dest))\n",
    "    print(\"Download complete!\")\n",
    "else:\n",
    "    print(\"Dataset already exists\")\n",
    "\n",
    "# Rewrite data.yaml — use absolute path to avoid any resolution issues\n",
    "yaml_path = DATA_DIR / \"data.yaml\"\n",
    "abs_root = str(DATA_DIR.resolve())\n",
    "yaml_text = 'path: ' + abs_root + '\\ntrain: data/train/images\\nval: data/val/images\\ntest: data/test/images\\nnc: 2\\nnames: [\"smoke\", \"fire\"]\\n'\n",
    "yaml_path.write_text(yaml_text)\n",
    "print(f\"data.yaml rewritten\")\n",
    "print(f\"  path: {abs_root}\")\n",
    "print(f\"  content:\\n{yaml_path.read_text()}\")"
    "\n",
    "# Verify the dataset directories exist where YOLO expects them\n",
    "expected_dirs = [\n",
    "    DATA_DIR / 'data' / 'train' / 'images',\n",
    "    DATA_DIR / 'data' / 'val' / 'images',\n",
    "    DATA_DIR / 'data' / 'test' / 'images',\n",
    "]\n",
    "for d in expected_dirs:\n",
    "    exists = '✓' if d.exists() else '✗ MISSING'\n",
    "    count = len(list(d.iterdir())) if d.exists() else 0\n",
    "    print(f\"  {exists} {d.relative_to(DATA_DIR)}/ ({count} files)\")\n",
    "print(f\"Dataset ready\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from ultralytics import YOLO\n",
    "\n",
    "model = YOLO(\"yolov8n.pt\")\n",
    "\n",
    "results = model.train(\n",
    "    data=\"data/raw/dfire/data.yaml\",\n",
    "    epochs=50,\n",
    "    batch=32,\n",
    "    imgsz=640,\n",
    "    patience=15,\n",
    "    device=\"cuda\",\n",
    "    workers=4,\n",
    "    optimizer=\"AdamW\",\n",
    "    lr0=0.001,\n",
    "    lrf=0.01,\n",
    "    augment=True,\n",
    "    mosaic=1.0,\n",
    "    mixup=0.1,\n",
    "    project=\"runs/train\",\n",
    "    name=\"dfire_full\",\n",
    "    exist_ok=True,\n",
    "    pretrained=True,\n",
    "    verbose=True,\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Validate best model on test set\n",
    "from ultralytics import YOLO\n",
    "best_path = \"runs/train/dfire_full/weights/best.pt\"\n",
    "val_model = YOLO(best_path)\n",
    "metrics = val_model.val(data=\"data/raw/dfire/data.yaml\", split=\"test\", device=\"cuda\")\n",
    "print(f\"\\nResults:\\nmAP50-95: {metrics.box.map:.4f}\\nmAP50: {metrics.box.map50:.4f}\\nPrecision: {metrics.box.p:.4f}\\nRecall: {metrics.box.r:.4f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
